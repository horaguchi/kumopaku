; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kumopaku"
run/main_scene="res://title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://global.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="uid://bu1r5dx7k717w"
theme/custom_font="uid://cx5v7ff6irohx"

[internationalization]

locale/translations=PackedStringArray("res://localization.en.translation", "res://localization.ja.translation", "res://localization.zh.translation", "res://localization_msg_a.en.translation", "res://localization_msg_a.ja.translation", "res://localization_msg_a.zh.translation", "res://localization_msg_b.en.translation", "res://localization_msg_b.ja.translation", "res://localization_msg_b.zh.translation", "res://localization_msg_c.en.translation", "res://localization_msg_c.ja.translation", "res://localization_msg_c.zh.translation", "res://localization_msg_d.en.translation", "res://localization_msg_d.ja.translation", "res://localization_msg_d.zh.translation", "res://localization_msg_e.en.translation", "res://localization_msg_e.ja.translation", "res://localization_msg_e.zh.translation", "res://localization_msg_f.en.translation", "res://localization_msg_f.ja.translation", "res://localization_msg_f.zh.translation", "res://localization_msg_g.en.translation", "res://localization_msg_g.ja.translation", "res://localization_msg_g.zh.translation", "res://localization_msg_h.en.translation", "res://localization_msg_h.ja.translation", "res://localization_msg_h.zh.translation", "res://localization_msg_i.en.translation", "res://localization_msg_i.ja.translation", "res://localization_msg_i.zh.translation", "res://localization_msg_k.en.translation", "res://localization_msg_k.ja.translation", "res://localization_msg_k.zh.translation", "res://localization_msg_l.en.translation", "res://localization_msg_l.ja.translation", "res://localization_msg_l.zh.translation", "res://localization_msg_m.en.translation", "res://localization_msg_m.ja.translation", "res://localization_msg_m.zh.translation", "res://localization_msg_n.en.translation", "res://localization_msg_n.ja.translation", "res://localization_msg_n.zh.translation", "res://localization_msg_o.en.translation", "res://localization_msg_o.ja.translation", "res://localization_msg_o.zh.translation", "res://localization_msg_p.en.translation", "r